# ══════════════════════════════════════════════════════════════════════════════
# Enterprise RAG Assistant — Environment Configuration Template
#
# Usage:
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# Then open .env and set at least one LLM API key before starting the app.
# DO NOT commit .env to version control — it is listed in .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM API Keys (at least one required) ──────────────────────────────────────
# OpenAI key takes priority and enables streaming responses.
# If absent, the app falls back to GOOGLE_API_KEY (standard display only).
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── LLM Model Names ───────────────────────────────────────────────────────────
# OpenAI: gpt-3.5-turbo | gpt-4o-mini | gpt-4o | gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo
# Google: gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
# NOTE: "gemini-pro" was deprecated by Google in February 2025.
GOOGLE_MODEL=gemini-2.5-flash

# ── Embedding & Reranker Models ───────────────────────────────────────────────
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Overridable without code changes. Lighter option: ms-marco-MiniLM-L-2-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Retrieval / Chunking Parameters ───────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Number of final passages returned after CrossEncoder reranking (increase for
# complex multi-section queries, at the cost of higher token usage).
TOP_K=4

# ── Path Locations ────────────────────────────────────────────────────────────
DATA_DIR=data/sample_docs
FAISS_INDEX_DIR=data/faiss_index
LOGS_DIR=logs
